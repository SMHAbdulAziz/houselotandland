{
  // House Lot & Land Sales Co. LLC website (deployed by Cloudflare Workers Builds on every push to main).
  "name": "houselotandland",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/offer/*", "/find", "/sign/*", "/doc/*", "/order/*", "/office", "/office/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hll-leads",
      "database_id": "41cd2c24-fb52-41ae-95b9-748ee75b2d31"
    }
  ],
  // Back office (/office) is behind Cloudflare Access. Fill these in from Zero Trust > Access > Applications;
  // they are not secrets. Until both are set, /office shows "locked". OFFICE_EMAILS (comma list) optionally narrows who
  // the Access policy already allows; leave it empty to rely on the Access policy alone.
  "vars": { "ACCESS_TEAM_DOMAIN": "houselotandland.cloudflareaccess.com", "ACCESS_AUD": "6ca563b888772f8fa15d4a8c6ca7bd530b21e3c93ed472d56920a0987fc2c368", "OFFICE_EMAILS": "" },
  "observability": { "enabled": true }
}
