# COGO Deal Analyzer Environment Configuration

# Application Settings
APP_NAME=COGO Deal Analyzer
APP_VERSION=1.0.0
DEBUG=false

# COGO Capital Settings
MIN_PROFIT_THRESHOLD=20000
MAX_LTV_RATIO=0.65
MAX_PURCHASE_RATIO=0.80
SELLING_COST_RATE=0.08
BROKER_FEE_RATE=0.03
FINANCE_COST_RATE=0.05

# File Paths
DATA_DIR=./data
REPORTS_DIR=./reports
TEMPLATES_DIR=./app/templates

# Export Settings
DEFAULT_EXPORT_FORMAT=json
ENABLE_PDF_EXPORT=true
ENABLE_CSV_EXPORT=true

# GUI Settings
WINDOW_WIDTH=1000
WINDOW_HEIGHT=700
THEME=default

# Docker Display Settings (for X11 forwarding)
DISPLAY=:0.0